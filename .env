# Defaults only. Put real values into .env.local (not committed).
APP_ENV=dev
APP_SECRET=change-me-in-env-local

# MySQL 8 / MariaDB 10.x. Adjust serverVersion to your server (e.g. mariadb-10.11.0).
DATABASE_URL="mysql://quiz:quiz@127.0.0.1:3306/quizbot?serverVersion=8.0.32&charset=utf8mb4"

# Telegram
TELEGRAM_BOT_TOKEN=000000:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-string-A-Za-z0-9_-
# Comma-separated Telegram user ids allowed to play. Empty = everyone.
TELEGRAM_ALLOWED_USER_IDS=
