# Copy to docker.env (Windows: copy docker.env.example docker.env) and fill in. Values without quotes.

# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Any random string of letters, digits, _ and - (used only if you later switch to a webhook)
TELEGRAM_WEBHOOK_SECRET=local-dev-secret

# Symfony secret: any long random string
APP_SECRET=change-me-to-a-long-random-string

# Telegram user ids allowed to play, comma-separated. Empty = everyone.
TELEGRAM_ALLOWED_USER_IDS=
